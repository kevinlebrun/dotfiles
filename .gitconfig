[user]
    email = kevin.lebrun@datadoghq.com
    name = Kevin Le Brun
[url "git@github.com:"]
    insteadOf = https://github.com/
[core]
    editor = nvim
    hooksPath = /usr/local/dd/global_hooks
	excludesfile = /Users/kevin.lebrun/.gitignore
    pager = less -FXR
    whitespace = trailing-space,space-before-tab
[color]
    ui = auto
[advice]
    pushNonFastForward = false
    statusHints = false
[alias]
    c = commit -v
    amend = commit --amend -C HEAD
    authors = "!git log --pretty=format:%aN | sort | uniq -c | sort -rn"
    changes = diff --name-status -r
    fuck = reset --hard
    l = "log --oneline --decorate --graph"
    lp = log --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative
    ls-ignored = ls-files --exclude-standard --ignored --others
    msg = commit --allow-empty -m
    news = log -p HEAD@{1}..HEAD@{0}
    push = push --tags
    s = status --short --branch
    undo = reset --soft HEAD@{1}
    rm-unstaged-stash = "!git stash --keep-index & git stash drop"
    rm-unstaged = "checkout --"
    sweep = "!git clean -df & git checkout -- ."
[push]
    default = tracking
[merge]
    stat = true
    diff = vimdiff
[pager]
    color = true
[status]
    submodulesummary = true
[diff]
    renames = copies
    mnemonicprefix = true
[diff "zip"]
    textconv = unzip -c -a
[branch]
    autosetupmerge = true
[rerere]
    enabled = true
[include]
	path = /Users/kevin.lebrun/.config/gitsign/gitconfig
[commit]
	gpgsign = true
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Users/kevin.lebrun/Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[maintenance]
	repo = /Users/kevin.lebrun/go/src/github.com/DataDog/dd-source
