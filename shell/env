# Shared environment for Bash and Zsh. No credentials or machine identity.
export CLICOLOR=1
export LSCOLORS=gxBxhxDxfxhxhxhxhxcxcx
export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"

# Preserve paths inherited from macOS, SSH and application launchers.
_dotfiles_prepend_path() {
    [ -d "$1" ] || return 0
    case ":$PATH:" in *":$1:"*) ;; *) PATH="$1:$PATH" ;; esac
}
for _dotfiles_dir in /usr/local/bin /usr/local/sbin /opt/homebrew/bin /opt/homebrew/sbin "$HOME/.lmstudio/bin" "$HOME/Library/Application Support/JetBrains/Toolbox/scripts" "$HOME/.local/bin" "$HOME/bin" "$DOTFILES/bin"; do
    _dotfiles_prepend_path "$_dotfiles_dir"
done
export PATH
unset _dotfiles_dir
unset -f _dotfiles_prepend_path

if command -v nvim >/dev/null 2>&1; then
    export EDITOR=nvim
elif command -v vim >/dev/null 2>&1; then
    export EDITOR=vim
fi
[ ! -t 0 ] || stty -ixon
